{
  "name": "oneulgam",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "prebuild": "node scripts/gen-sw-config.mjs",
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "lint": "eslint .",
    "test": "node --experimental-strip-types --test tests/unit/*.test.ts",
    "test:rules": "firebase emulators:exec --only firestore \"node --test tests/rules/*.test.mjs\"",
    "seed:config": "node scripts/seed-config.mjs",
    "seed:emulator": "node scripts/seed-emulator.mjs",
    "verify": "pnpm lint && pnpm test && pnpm --dir functions build && pnpm --dir functions test && pnpm build",
    "deploy:dev": "pnpm build && firebase deploy -P dev",
    "deploy:prod": "pnpm build && firebase deploy -P prod --only hosting,functions,firestore"
  },
  "dependencies": {
    "firebase": "^12.16.0",
    "motion": "^12.42.2",
    "next": "16.2.11",
    "pretendard": "^1.3.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@next/env": "16.2.11",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "firebase-admin": "^14.2.0",
    "firebase-tools": "^15.24.0",
    "typescript": "^5"
  }
}
